# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
dist/
build/

# Node / frontend
node_modules/
.vite/
*.tsbuildinfo

# Use pnpm-lock.yaml only; npm's lockfile is generated when contributors
# run `npm install` instead of `pnpm install` and should not be tracked.
package-lock.json

# IDE
.vscode/
.idea/

# Local git worktrees (created via `git worktree add .worktrees/<name>`)
.worktrees/

# Claude Code: personal permission overrides; project settings + hooks are tracked
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# scripts/run.sh runtime state (PIDs, ports); consumed by scripts/shutdown.sh
.grimoire-run.env

# OS
.DS_Store
Thumbs.db

# Legacy repo-local data/ tree — nothing in the codebase reads it now
# (the default data root is $HOME/.grimoire; override with
# GRIMOIRE_DATA_ROOT). Kept as an ignore so a developer pointing
# GRIMOIRE_DATA_ROOT back at the repo doesn't accidentally commit user
# content.
data/
docs/.obsidian/
