<?xml version="1.0" encoding="utf-8"?>
<!-- The dark field the launcher's mask cuts out of: the same top-to-bottom
     gradient as the tile in frontend/public/grimoire-512.png, so the feathered
     edges of ic_launcher_foreground disappear into it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="270"
        android:startColor="#1E1F26"
        android:endColor="#14151A" />
</shape>
