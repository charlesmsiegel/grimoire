        {
          "response_id": "e07fe538b3284f0bb68d5c293a222dd7",
          "speaker_ref": "characters:bellamy",
          "text": "Come, come, to the balcony, my dear! Hush now, darling, the voices below are simply dripping with intrigue!"
        }
      ]
    },
    {
