      "player_text": "I follow Bellamy out to the balcony.",
      "responses": [
        {
          "response_id": "99408aa822c6441280d7daf2b6faac96",
          "speaker_ref": "characters:oda",
          "text": "Balcony's shut after dark. Go if you must. Quickly."
