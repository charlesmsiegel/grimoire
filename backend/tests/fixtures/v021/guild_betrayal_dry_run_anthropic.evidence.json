  "turns": [
    {
      "turn": 1,
      "player_text": "I slide a silver coin across the counter and ask Oda for the guest ledger.",
      "responses": [
        {
          "response_id": "a4e2e75afb924d378be3298c3a7cdc72",
          "speaker_ref": "characters:oda",
          "text": "Coin's good. Guest ledger's on the hook. Read it here."
        },
        {
          "response_id": "2b155c0a87c44695ab466fc91061dbe8",
          "speaker_ref": "characters:bellamy",
          "text": "Oh, darling Wren, a ledger! How deliciously bureaucratic of you, truly marvellous!"
        }
      ]
    },
    {
      "turn": 2,
      "player_text": "I follow Bellamy out to the balcony.",
      "responses": [
        {
          "response_id": "6a1f324027d040f884190a7c3e721878",
          "speaker_ref": "characters:oda",
          "text": "Balcony's shut after dark. Go if you must. Quickly."
        },
        {
          "response_id": "413c6724fe854f64b5da67dd10219cae",
          "speaker_ref": "characters:bellamy",
          "text": "Come, come, to the balcony, my dear! Hush now, darling, the voices below are simply dripping with intrigue!"
        }
      ]
    },
    {
      "turn": 3,
      "player_text": "I ask Bellamy to sing what was overheard.",
      "responses": [
        {
          "response_id": "eadfb37622ee43f4a1c7db5f12265246",
          "speaker_ref": "characters:oda",
          "text": "Singing. In my hall. Fine. Rules are rules, so keep it short."
        },
        {
          "response_id": "c199e24ff2634ff9ae496701acafc7c2",
          "speaker_ref": "characters:bellamy",
          "text": "Oh, my darling, it is a dreadful song: the duke sold the guild to the river barons, every last splendid brick!"
        }
      ]
    }
  ],
