{#-
  Negative image prompt — preset negative followed by each character's
  negative_prompt, comma-joined.

  Inputs:
    preset_negative     str
    character_negatives list[str]
-#}
{%- set parts = [] -%}
{%- if preset_negative and preset_negative.strip() %}{% set _ = parts.append(preset_negative.strip()) %}{% endif -%}
{%- for negative in character_negatives or [] %}{% if negative and negative.strip() %}{% set _ = parts.append(negative.strip()) %}{% endif %}{% endfor -%}
{{ parts | join(", ") }}
