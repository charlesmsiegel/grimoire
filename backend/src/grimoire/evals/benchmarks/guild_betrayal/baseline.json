          "author": "player",
          "text": "I slide a silver coin across the counter and ask Oda for the guest ledger.",
          "call_id": null
        },
        {
          "speaker_id": "npc-oda",
          "author": "model",
          "text": "Coin's good. Guest ledger's on the hook. Read it here.",
          "call_id": "t1-oda"
        },
        {
          "speaker_id": "npc-bellamy",
          "author": "model",
          "text": "Oh, darling Wren, a ledger! How deliciously bureaucratic of you, truly marvellous!",
          "call_id": "t1-bellamy"
        },
        {
          "speaker_id": null,
          "author": "model",
          "text": "Oda pushes the guest ledger across the counter. Behind him the sealed vault door gleams.",
          "call_id": "t1-narration"
