    {
      "turn": 2,
      "contributions": [
        {
          "speaker_id": "pc-wren",
          "author": "player",
          "text": "I follow Bellamy out to the balcony.",
          "call_id": null
        },
        {
          "speaker_id": "npc-oda",
          "author": "model",
          "text": "Balcony's shut after dark. Go if you must. Quickly.",
          "call_id": "t2-oda"
        },
        {
          "speaker_id": "npc-bellamy",
          "author": "model",
          "text": "Come, come, to the balcony, my dear! Hush now, darling, the voices below are simply dripping with intrigue!",
          "call_id": "t2-bellamy"
        },
        {
          "speaker_id": null,
          "author": "model",
          "text": "On the balcony, voices drift up from the courtyard, too faint for Wren to make out.",
          "call_id": "t2-narration"
        }
      ]
    },
    {
      "turn": 3,
      "contributions": [
        {
          "speaker_id": "pc-wren",
          "author": "player",
          "text": "I ask Bellamy to sing what was overheard.",
          "call_id": null
        },
        {
          "speaker_id": "npc-oda",
          "author": "model",
          "text": "Singing. In my hall. Fine. Rules are rules, so keep it short.",
          "call_id": "t3-oda"
        },
        {
          "speaker_id": "npc-bellamy",
          "author": "model",
          "text": "Oh, my darling, it is a dreadful song: the duke sold the guild to the river barons, every last splendid brick!",
          "call_id": "t3-bellamy"
        },
        {
          "speaker_id": null,
          "author": "model",
          "text": "Bellamy sings softly, and the tune echoes off the sealed vault door.",
          "call_id": "t3-narration"
        }
      ]
    }
