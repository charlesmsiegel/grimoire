{#- The authoritative history frame, shared by retrieval fitting and S2.
    Vars: history_blocks ([str]) or history_evidence ([EvidenceItem]).
    Blocks may be frozen after macro expansion; this frame owns every join. -#}
{%- set blocks = history_blocks if history_blocks is defined else [] -%}
{%- if history_blocks is not defined -%}
{%- for item in history_evidence -%}
{%- set block -%}{%- include "scene/sections/history_item.j2" -%}{%- endset -%}
