{#- Present-cast feelings and bonds. Vars: relationship_lines ([str] — lines
    rendered per snippets/feeling_line.j2 and snippets/bond_line.j2). -#}
{%- from "scene/_sources.j2" import source_text with context -%}
{%- set lines = [] -%}
{%- for line in relationship_lines -%}
{#- The whole line is its own label: a name may contain ": ", so the line is
    never split to recover one. Each line names one pair, so no two collide. -#}
{%- set _ = lines.append(source_text(line, line)) -%}
{%- endfor -%}
{%- if lines %}# Relationships
{{ lines | join("\n") }}{% endif -%}
