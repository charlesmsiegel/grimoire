{#- One bounded history unit. Original summary survives omission on the item.
    Vars: item (EvidenceItem), with safe title/date/location and prompt excerpts;
    optionally history_notes ({scene key: note}), where a note may carry
    known_to and suspected_by (names, for the narrator's annotation lines,
    which go directly after the header) and labels (one access per excerpt) and
    summary_label (an actor's: witnessed, known or suspected). An empty title
    is left out, and an empty header with it. -#}
{%- set note = history_notes.get(item.scene.key, {}) if history_notes is defined and history_notes else {} -%}
{%- set wording = {"witnessed": "You were there:", "known": "You know this:", "suspected": "Suspected, unconfirmed:"} -%}
{%- set header = [("**" ~ item.title ~ "**") if item.title else "", item.date, item.location] | select | join(" — ") -%}
{%- set lines = [header] if header else [] -%}
{%- if note.get("known_to") %}{% set _ = lines.append("Known to: " ~ (note["known_to"] | join(", "))) %}{% endif -%}
{%- if note.get("suspected_by") %}{% set _ = lines.append("Suspected by: " ~ (note["suspected_by"] | join(", "))) %}{% endif -%}
{%- set parts = [lines | join("\n")] if lines else [] -%}
{%- if item.summary and not item.summary_omission -%}
{%- set _ = parts.append(((wording[note["summary_label"]] ~ "\n") if note.get("summary_label") else "") ~ item.summary) -%}
{%- endif -%}
{%- for excerpt in item.excerpts -%}
{%- set labels = note.get("labels") or [] -%}
{%- set label = labels[loop.index0] if labels | length > loop.index0 else "" -%}
{%- if excerpt.text -%}{%- set _ = parts.append(((wording[label] ~ "\n") if label else "") ~ excerpt.text) -%}{%- endif -%}
{%- endfor -%}
{{ parts | join("\n\n") }}
