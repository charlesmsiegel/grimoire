{#- Correct only measured overshoot by this assigned actor. -#}
{%- set lines = [] -%}
{%- if drift.tier -%}
{%- set _ = lines.append(
  "Your recent contributions have run long: " ~ (drift.totals | join(", ")) ~
  " words against a configured " ~ budget.words ~ "-word upper limit. " ~
  ("Cut back substantially." if drift.tier == "cut" else "Stay within the limit; shorter is welcome.")) -%}
{%- endif -%}
{%- if drift.paragraphs -%}
{%- set _ = lines.append(
  "Recent contributions used more than " ~ budget.paragraphs ~
  " paragraphs. Use at most that many; do not fill them unnecessarily.") -%}
{%- endif -%}
{{ lines | join("\n") }}
