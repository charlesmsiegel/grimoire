{#- Correct only measured overshoot by this assigned actor. -#}
{%- set lines = [] -%}
{%- if drift.tier -%}
{%- set _ = lines.append(
  "Your recent contributions have run long: " ~ (drift.totals | join(", ")) ~
  " words against an approximate " ~ budget.words ~ "-word target. " ~
  ("Cut back substantially." if drift.tier == "cut" else "Trim toward the target.")) -%}
{%- endif -%}
{%- if drift.paragraphs -%}
{%- set _ = lines.append(
  "Recent contributions used more than about " ~ budget.paragraphs ~
  " paragraphs. Keep this one closer to that target.") -%}
{%- endif -%}
{{ lines | join("\n") }}
