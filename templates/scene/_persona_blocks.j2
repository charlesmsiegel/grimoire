{#- Shared persona-block formats for the "Player personas" and "Absent player
    characters" sections. pc_block: a PC persona ({name, pronouns, summary,
    description, goals, player_notes}) -- the two profile fields (#65) are a
    line each, after the description, and only when set, so a PC without them
    renders exactly as it did before they existed; char_block: a character
    card played as a player ({name, description, personality}). -#}
{%- macro pc_block(p) -%}
{%- set head = [p.get("name", ""), p.get("pronouns", "")] | select | join(", ") -%}
{%- set body = [p.get("summary", ""), p.get("description", "")] | select | join("\n") -%}
{%- set goals = p.get("goals", "") -%}
{%- set notes = p.get("player_notes", "") -%}
{%- set profile = [("Goals: " ~ goals) if goals else "",
                   ("Narrator guidance: " ~ notes) if notes else ""] | select | join("\n") -%}
{{ ([head, body, profile] | select | join("\n")).strip() }}
{%- endmacro -%}
{%- macro char_block(p) -%}
{%- set body = [p.get("description", "").strip(), p.get("personality", "").strip()] | select | join("\n") -%}
{{ ([p.get("name", ""), body] | select | join("\n")).strip() }}
{%- endmacro -%}
