{#- The reconciliation sweep's user message: every selected candidate and the
    records it names. Mirrors store/continuity/reconcile.py:build_prompt.
    Vars (reconcile.template_vars): now (the campaign date, friendly form, or
    blank), chronicle [{id, one_line}] (the scene lines shown, by id),
    candidates [{key ("c1", ...), label (what is being asked), words (the
    vocabulary the answer must come from), records [{letter ("A" | "B"), ref,
    type ("plot thread" | "commitment", or blank for an event, whose line
    names itself), line (snippets/plot_thread_line/absorb.j2 or
    snippets/commitment_line/absorb.j2, or "event: <name> (<date>)", rendered
    by Python), beats [{scene, text}] (oldest first), pressure, links [str],
    actors [names]}], signal_text}]. Every key is always passed; a blank one
    renders nothing. -#}
{% if now -%}
Campaign date: {{ now }}
{% endif -%}
{% if chronicle -%}
Recent scenes:
{% for s in chronicle -%}
- {{ s.id }} — {{ s.one_line }}
{% endfor -%}
{% endif -%}
{% for c in candidates -%}
{% if not loop.first %}

{% elif now or chronicle %}
{% endif -%}
Candidate {{ c.key }} — {{ c.label }} (answer with: {% for w in c.words %}"{{ w }}"{% if not loop.last %}, {% endif %}{% endfor %})
{%- for r in c.records %}
{{ r.letter }}{% if r.type %} ({{ r.type }}){% endif %}: {{ r.line }}
{%- for b in r.beats %}
  {% if b.scene %}[{{ b.scene }}] {% endif %}{{ b.text }}
{%- endfor %}
{%- if r.pressure %}
  pressure: {{ r.pressure }}
{%- endif %}
{%- if r.links %}
  links: {{ r.links | join("; ") }}
{%- endif %}
{%- if r.actors %}
  people: {{ r.actors | join(", ") }}
{%- endif %}
{%- endfor %}
{%- if c.signal_text %}
signals: {{ c.signal_text }}
{%- endif %}
{%- endfor %}
