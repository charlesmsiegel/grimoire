{#- The duplicate check's user message: every examined row and its neighbours.
    Mirrors store/continuity/identity.py:build_prompt.
    Vars: rows (identity.template_rows) -- each {key, kind ("thread" |
    "commitment"), title, beat, status, commitment_kind, due, quote, speaker,
    certainty (a number or none), why_new, distinguished_from [ids],
    candidates [{line (snippets/plot_thread_line/absorb.j2 or
    snippets/commitment_line/absorb.j2, rendered by Python), earlier [beat
    texts, newest first], signal_text, ...}]}. Every key is always passed;
    a blank one renders nothing. -#}
{% for r in rows -%}
{% if not loop.first %}

{% endif -%}
Row {{ r.key }} — proposed {{ "plot thread" if r.kind == "thread" else "commitment" }}: {{ r.title }}
Beat: {{ r.beat }}
{%- if r.status %}
Status: {{ r.status }}
{%- endif %}
{%- if r.commitment_kind %}
Kind: {{ r.commitment_kind }}
{%- endif %}
{%- if r.due %}
Due: {{ r.due }}
{%- endif %}
{%- if r.quote or r.speaker or r.certainty is not none %}
Cited:
{%- if r.quote %} "{{ r.quote }}"{% endif %}
{%- if r.speaker %}{% if r.quote %} —{% endif %} {{ r.speaker }}{% endif %}
{%- if r.certainty is not none %}{% if r.quote or r.speaker %},{% endif %} certainty {{ r.certainty }}{% endif %}
{%- endif %}
{%- if r.why_new %}
Why new: {{ r.why_new }}
{%- endif %}
{%- if r.distinguished_from %}
Distinguished from: {{ r.distinguished_from | join(", ") }}
{%- endif %}
Candidates:
{%- for c in r.candidates %}
- {{ c.line }}
{%- for beat in c.earlier %}
  Earlier: {{ beat }}
{%- endfor %}
  signals: {{ c.signal_text }}
{%- endfor %}
{%- endfor %}
