{#- The campaign capsule's user message: the character's card, one non-empty
    field per line, then the excerpt of the first scene the character appears in
    when there is one. Vars: card (dict with name/description/personality/
    scenario), excerpt (the scene's text, or ""). -#}
{%- set fields = [card.get("name", ""), card.get("description", ""), card.get("personality", ""), card.get("scenario", "")] -%}
{{ fields | select | join("\n") }}
{%- if excerpt %}

The first scene this character appears in:
{{ excerpt }}
{%- endif %}
