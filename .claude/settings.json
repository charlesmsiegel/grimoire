{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/guard-writes.py",
            "shell": "bash",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
